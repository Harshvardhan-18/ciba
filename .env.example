# Backend environment — copy to .env and fill in real values. Never commit .env.
# Read by app/config.py (pydantic-settings).

# Same value as frontend/.env.local NEXTAUTH_SECRET — FastAPI verifies the
# NextAuth HS256 JWT using this secret.
NEXTAUTH_SECRET=dev-secret-change-me

# Postgres (local docker-compose)
DATABASE_URL=postgresql+asyncpg://ciba:ciba_dev@localhost:5432/ciba_db

# Director LLM: "groq" (default, fast + free) | "gemini" — one-line swap
LLM_PROVIDER=groq
# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Image generation provider: "mock" | "flux2_klein_kaggle" | "gemini"
IMAGE_GENERATION_PROVIDER=mock
# Placements to generate per campaign: "all" or a subset like "ig_feed"
GENERATE_PLACEMENTS=all

# Generation worker tunnel (ngrok/cloudflared from notebook_test.ipynb)
KAGGLE_GATEWAY_URL=
# Optional shared secret sent as `Authorization: Bearer` to the workers
KAGGLE_API_KEY=

# Vision evaluation: "mock" | "hybrid"
VISION_EVALUATOR_PROVIDER=mock
# Which backend runs the VLM: "kaggle" (free, default) | "gemini" — one-line swap
VLM_PROVIDER=kaggle
# Eval worker tunnel (ngrok/cloudflared from eval_worker_test.ipynb)
KAGGLE_EVAL_GATEWAY_URL=

# Echo every SQL query to the console (debugging). Default: false
# SQL_ECHO=false

# Only needed when VLM_PROVIDER=gemini
# GEMINI_API_KEY=
